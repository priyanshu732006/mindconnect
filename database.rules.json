
{
  "rules": {
    /* 
      Security Rules Version: 1.3.0
      Last updated: 2024-05-24 20:30:00
      Fix: Explicitly allow authenticated read at root of peerBuddies and chats to enable listing.
    */
    "peerBuddies": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    }
  }
}
