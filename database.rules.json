
{
  "rules": {
    /* 
      Security Rules Version: 1.1.7
      Last updated: 2024-05-24 16:30:00
      Fix: Explicitly allow authenticated read at the parent level for peerBuddies to support directory listing.
      Security: Restricting write access to the specific user's node.
    */
    "peerBuddies": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    }
  }
}
