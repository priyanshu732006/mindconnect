
{
  "rules": {
    /* 
      Security Rules Version: 1.0.4
      Last updated: 2024-05-22
      Description: Public read for peer buddy directory to prevent client-side race conditions.
    */
    "peerBuddies": {
      ".read": true,
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
