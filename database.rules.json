
{
  "rules": {
    /* 
      Security Rules Version: 1.0.7
      Last updated: 2024-05-22 15:30:00
      Description: Ensuring public read access for the peer buddy directory to prevent persistent permission errors.
    */
    "peerBuddies": {
      ".read": true,
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.contains(auth.uid))",
        ".write": "auth != null && ($chatId.contains(auth.uid))"
      }
    }
  }
}
