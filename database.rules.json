{
  "rules": {
    /* 
      Last updated: 2024-05-20 (Triggering deployment)
      Public directory for available peer buddies.
    */
    "peerBuddies": {
      ".read": true,
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
