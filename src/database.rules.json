
{
  "rules": {
    /* 
      Security Rules Version: 1.0.9
      Last updated: 2024-05-22 18:00:00
      Fix: Allowing public read for peerBuddies directory to avoid auth race conditions.
    */
    "peerBuddies": {
      ".read": true,
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.contains(auth.uid))",
        ".write": "auth != null && ($chatId.contains(auth.uid))"
      }
    }
  }
}
