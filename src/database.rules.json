
{
  "rules": {
    /* 
      Last updated: 2024-05-21 (Adding chat persistence)
      Public directory for available peer buddies.
    */
    "peerBuddies": {
      ".read": true,
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    /* 
      Secure chat paths. Chat IDs are usually formatted as studentUid_buddyUid.
    */
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
