{
  "rules": {
    /* 
      Security Rules Version: 1.1.4
      Last updated: 2024-05-24 12:00:00
      Fix: Public read for peerBuddies directory to resolve persistent listing errors.
      Security: Restricting chat access to participants only.
    */
    "peerBuddies": {
      ".read": "true",
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    }
  }
}