
{
  "rules": {
    /* 
      Security Rules Version: 1.1.9
      Last updated: 2024-05-24 18:00:00
      Fix: Forced redeploy to ensure authenticated root read for directories.
    */
    "peerBuddies": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    }
  }
}
