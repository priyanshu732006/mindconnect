{
  "rules": {
    /* 
      Security Rules Version: 1.1.3
      Last updated: 2024-05-24 11:30:00
      Fix: Explicitly allowing authenticated read for the collections to resolve listing errors.
    */
    "peerBuddies": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userRoles": {
      ".read": "auth != null",
      ".indexOn": "role",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "studentData": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "chats": {
      ".read": "auth != null",
      "$chatId": {
        ".read": "auth != null && ($chatId.contains(auth.uid))",
        ".write": "auth != null && ($chatId.contains(auth.uid))"
      }
    }
  }
}
